[Unit]
Description=Rift parent-proxy (HTTP↔vsock bridge for the signing enclave)
Documentation=https://github.com/Rift-FI/Rift-secure-signing-enclave
After=network-online.target nitro-enclaves-allocator.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rift-parent-proxy
Restart=on-failure
RestartSec=3

# Hardening — proxy holds no secrets but it does hold IAM credentials
# for KMS, so minimise the blast radius.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/etc /usr
PrivateDevices=false       # need /dev/vsock for the KMS proxy listener
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Env — tune per host. The defaults match the values baked into the
# enclave binary (port 5005 for signing, 5006 for KMS proxy).
Environment=AWS_REGION=us-east-1
Environment=ENCLAVE_PORT=5005
Environment=KMS_PROXY_PORT=5006
# HTTP_BIND defaults to 0.0.0.0:7777 in the binary so the parent-proxy
# is reachable from off-host (nginx in front terminates TLS + filters
# by hostname). Override to 127.0.0.1:7777 if you want it host-local
# only — useful when running the smoke-test curl on the box itself
# without exposing the port at all.
#
# PARENT_PROXY_AUTH_TOKEN, when set, gates /sign with
# `Authorization: Bearer <token>`. Strongly recommended whenever
# HTTP_BIND is non-localhost. Smart-wallet on Railway sends the same
# value in its `Authorization` header.
#
# Both env vars are intentionally set in the env file (not the unit)
# so rotating the token is `vi /etc/rift-parent-proxy.env` +
# `systemctl restart rift-parent-proxy` with no git churn.
EnvironmentFile=-/etc/rift-parent-proxy.env

[Install]
WantedBy=multi-user.target
